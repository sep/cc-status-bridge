<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (Windows-subsystem): no console allocated when launched from
         a scheduled task / installer / shortcut — the bridge is a tray app.
         CLI subcommands re-attach to the parent shell's console at startup
         via AttachConsole(ATTACH_PARENT_PROCESS); see ConsoleAttach.cs. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClaudeStatusBridge</RootNamespace>
    <AssemblyName>ClaudeStatusBridge</AssemblyName>
    <VersionFile>$(MSBuildThisFileDirectory)version.txt</VersionFile>
    <Version Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</Version>
    <Version Condition="!Exists('$(VersionFile)')">0.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- InvariantGlobalization disabled because Avalonia's Fluent theme
         and some text rendering paths rely on globalization data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />

    <!-- Avalonia for the system-tray UI (v0.2.2). Tray icon + native menu;
         no main window, ShutdownMode.OnExplicitShutdown lets the bridge
         keep running even when the user has no windows open. -->
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />

    <!-- Override Avalonia's transitive Tmds.DBus.Protocol 0.20.0 (flagged
         by GHSA-xrw6-gwf8-vvr9: malicious D-Bus peers can spoof signals
         and exhaust FDs). 0.21.3 is the in-series patched release. Only
         actually exercised on Linux; Windows / macOS don't load it. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
