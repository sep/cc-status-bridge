<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the transport layer straight from the bridge tree: the bridge is a
         self-contained WinExe and can't be project-referenced. -->
    <Compile Include="../../IDeviceLink.cs" />
    <Compile Include="../../SshTunnelLink.cs" />
    <Compile Include="../../BridgeOptions.cs" />
  </ItemGroup>
</Project>
